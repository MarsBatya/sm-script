#!/usr/bin/env bash

# Service Manager (sm) - A lightweight wrapper around systemctl and journalctl
# Usage: sm <command> [args]

set -e

# Configuration
SM_DIR="$HOME/.sm"
SM_PROJECTS_FILE="$SM_DIR/projects.txt"
SERVICE_TEMPLATE="$SM_DIR/service.template"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Initialize sm directory and files
init_sm() {
    if [[ ! -d "$SM_DIR" ]]; then
        mkdir -p "$SM_DIR"
    fi
    
    if [[ ! -f "$SM_PROJECTS_FILE" ]]; then
        touch "$SM_PROJECTS_FILE"
    fi
    
    if [[ ! -f "$SERVICE_TEMPLATE" ]]; then
        cat > "$SERVICE_TEMPLATE" << 'EOF'
[Unit]
Description={{DESCRIPTION}}
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=10
User={{USER}}
WorkingDirectory={{WORKING_DIR}}
ExecStart={{EXEC_START}}
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
    fi
}

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Registry lines are "name:service_file:working_dir:owned". "owned" is 1 if
# sm installed the unit file into /etc/systemd/system (and so may remove it
# later), 0 if it only registered a pre-existing unit it doesn't manage.
# Legacy lines (created before "owned" existed) have no 4th field.

# Validate a project/service name: must be safe as a systemd unit name, as
# a registry key (no ':', our field separator), and as a path component.
valid_project_name() {
    local name="$1"
    # Leading '-' is excluded even though it's otherwise a legal character:
    # every command that takes a positional [project_name] parses a
    # leading-'-' argument as an unknown flag first, so such a name could
    # be registered but never referenced again.
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ && "$name" != -* ]]
}

# Check if project exists in our registry. Uses an exact field match
# (not a regex prefix match) so names containing regex metacharacters
# can't cause false matches against other entries.
project_exists() {
    local name="$1"
    awk -F: -v n="$name" '$1 == n { found = 1 } END { exit !found }' "$SM_PROJECTS_FILE" 2>/dev/null
}

# Add project to registry. $4 (owned) defaults to 1 for callers that don't
# pass it, since that's the common case (sm installed the unit file).
add_to_registry() {
    local name="$1"
    local service_file="$2"
    local working_dir="$3"
    local owned="${4:-1}"
    echo "$name:$service_file:$working_dir:$owned" >> "$SM_PROJECTS_FILE"
}

# Get service file path for project
get_service_file() {
    local name="$1"
    awk -F: -v n="$name" '$1 == n { print $2; exit }' "$SM_PROJECTS_FILE" 2>/dev/null
}

# Pre-flight validation before starting/restarting a service: runs
# `systemd-analyze verify` against the unit file so a bad directive (e.g.
# an ExecStart binary that doesn't exist, or a bad option) surfaces as a
# clear message here, instead of only showing up afterwards as "Failed to
# start service, use 'sm logs'".
#
# Prefers the installed /etc/systemd/system copy -- that's what systemd
# actually loads, and it's world-readable so this needs no sudo -- and
# falls back to the local copy sm has on record (registry field 2) only if
# the installed one isn't there/readable. This matters for "management
# only" (owned=0) projects in particular: their registry entry points at
# the project directory's copy, which can freely diverge from the
# pre-existing installed unit that's the one actually authoritative.
#
# Returns 1 only on a hard validation error (the unit would fail to load).
# Warnings are printed but don't block. Missing systemd-analyze, or no
# file to check, silently skips validation rather than blocking.
verify_service_file() {
    local name="$1"
    local service_file="/etc/systemd/system/$name.service"
    if [[ ! -r "$service_file" ]]; then
        service_file=$(get_service_file "$name")
    fi

    [[ -z "$service_file" || ! -f "$service_file" ]] && return 0
    command -v systemd-analyze >/dev/null 2>&1 || return 0

    local verify_output verify_status
    # Run with sudo if available so systemd-analyze has permission to initialize its
    # internal manager and transient cgroups when verifying system unit files.
    if command -v sudo >/dev/null 2>&1; then
        verify_output=$(sudo systemd-analyze verify "$service_file" 2>&1)
        verify_status=$?
    else
        verify_output=$(systemd-analyze verify "$service_file" 2>&1)
        verify_status=$?
    fi

    # Filter out harmless systemd internal cleanup noise (emitted when /tmp is not on tmpfs)
    verify_output=$(echo "$verify_output" | grep -v "Attempted to remove disk file system" || true)

    if [[ $verify_status -ne 0 ]]; then
        # If the failure is purely an environment/cgroup permission restriction preventing
        # systemd-analyze from initializing its test manager, skip rather than hard-blocking.
        local non_env_errors
        non_env_errors=$(echo "$verify_output" | grep -v -E "Failed to initialize manager|control group: Permission denied" || true)
        if [[ -z "$non_env_errors" ]]; then
            log_warning "systemd-analyze could not initialize manager in this environment; skipping validation."
            return 0
        fi

        log_error "Unit file '$service_file' failed validation:"
        echo "$verify_output" | sed 's/^/  /' >&2
        return 1
    fi

    if [[ -n "$verify_output" ]]; then
        log_warning "Unit file '$service_file' has warnings:"
        echo "$verify_output" | sed 's/^/  /' >&2
    fi

    return 0
}

# Remove project from registry. Uses the same exact field match as
# project_exists/get_service_file (rather than a sed regex address) so a
# '.' in the name -- a legal character per valid_project_name, but a
# "match any character" wildcard in a regex -- can't cause this to delete
# an unrelated entry too (e.g. removing "my.app" deleting "myXapp").
remove_from_registry() {
    local name="$1"
    if [[ -f "$SM_PROJECTS_FILE" ]]; then
        local tmp
        tmp=$(mktemp "${SM_PROJECTS_FILE}.XXXXXX")
        awk -F: -v n="$name" '$1 != n' "$SM_PROJECTS_FILE" > "$tmp" && mv "$tmp" "$SM_PROJECTS_FILE"
    fi
}

# Infer project name from .service file in current directory
infer_project_name() {
    local current_dir=$(pwd)
    local service_files=(*.service)
    
    # Check if any .service files exist
    if [[ ${#service_files[@]} -eq 1 && "${service_files[0]}" == "*.service" ]]; then
        return 1  # No service files found
    fi
    
    if [[ ${#service_files[@]} -eq 1 ]]; then
        # Single service file found
        local service_file="${service_files[0]}"
        local name=$(basename "$service_file" .service)
        if ! valid_project_name "$name"; then
            log_error "Service file name '$service_file' contains characters sm can't safely use as a project name (only letters, digits, '.', '_', '-' allowed)" >&2
            return 1
        fi
        echo "$name"
        return 0
    else
        # Multiple service files found
        # NOTE: this function's stdout is captured via $(...) by callers, so
        # every bit of human-facing output here must go to stderr, leaving
        # stdout for the final "$name" only.
        log_warning "Multiple .service files found in current directory:" >&2
        for i in "${!service_files[@]}"; do
            echo "  $((i+1))) ${service_files[$i]}" >&2
        done
        read -p "Select service file (1-${#service_files[@]}): " choice

        if [[ "$choice" -ge 1 && "$choice" -le ${#service_files[@]} ]]; then
            local service_file="${service_files[$((choice-1))]}"
            local name=$(basename "$service_file" .service)
            if ! valid_project_name "$name"; then
                log_error "Service file name '$service_file' contains characters sm can't safely use as a project name (only letters, digits, '.', '_', '-' allowed)" >&2
                return 1
            fi
            echo "$name"
            return 0
        else
            log_error "Invalid selection" >&2
            return 1
        fi
    fi
}

# Escape a string for safe use as the replacement side of a sed "s|||"
# expression: backslash-escape the delimiter (|) and the two characters
# (& and \) sed treats specially in a replacement.
sed_escape_replacement() {
    printf '%s' "$1" | sed -e 's/[\&|]/\\&/g'
}

# Generate service file from template
generate_service() {
    local name="$1"
    local description="$2"
    local exec_start="$3"
    local working_dir="$4"
    local user="$5"
    local service_file="$working_dir/$name.service"

    local esc_description esc_user esc_working_dir esc_exec_start
    esc_description=$(sed_escape_replacement "$description")
    esc_user=$(sed_escape_replacement "$user")
    esc_working_dir=$(sed_escape_replacement "$working_dir")
    esc_exec_start=$(sed_escape_replacement "$exec_start")

    # Two-phase substitution: first swap the template's {{PLACEHOLDER}}
    # markers for unique internal sentinels (\x01 is not typeable via
    # `read -p`, so it can't collide with user input), THEN swap the
    # sentinels for the actual escaped values. Doing it in one pass would
    # let a later -e see text just inserted by an earlier one -- e.g. a
    # Description containing the literal string "{{EXEC_START}}" would
    # get that text replaced by the real exec_start value, since sed has
    # no notion of "already substituted" text within a line.
    local m_desc=$'\x01SM_DESCRIPTION\x01'
    local m_user=$'\x01SM_USER\x01'
    local m_wd=$'\x01SM_WORKING_DIR\x01'
    local m_exec=$'\x01SM_EXEC_START\x01'

    sed -e "s|{{DESCRIPTION}}|$m_desc|g" \
        -e "s|{{USER}}|$m_user|g" \
        -e "s|{{WORKING_DIR}}|$m_wd|g" \
        -e "s|{{EXEC_START}}|$m_exec|g" \
        "$SERVICE_TEMPLATE" | \
    sed -e "s|$m_desc|$esc_description|g" \
        -e "s|$m_user|$esc_user|g" \
        -e "s|$m_wd|$esc_working_dir|g" \
        -e "s|$m_exec|$esc_exec_start|g" \
        > "$service_file"

    echo "$service_file"
}

# Find the directory containing the sm script
find_sm_repo() {
    # Get the actual path of the sm script (resolving symlinks)
    local sm_script_path
    sm_script_path=$(readlink -f "$(command -v sm)")
    
    if [[ -z "$sm_script_path" ]]; then
        return 1
    fi
    
    # Get the directory containing the script
    dirname "$sm_script_path"
}

# Command implementations
cmd_add() {
    local current_dir=$(pwd)
    local service_files=(*.service)
    
    # Check if any .service files exist
    if [[ ${#service_files[@]} -eq 1 && "${service_files[0]}" == "*.service" ]]; then
        log_info "No .service file found in current directory."
        echo
        read -p "Generate a new service file? (y/N): " generate
        
        if [[ "$generate" =~ ^[Yy]$ ]]; then
            echo
            read -p "Project name: " name
            [[ -z "$name" ]] && { log_error "Project name is required"; exit 1; }

            if ! valid_project_name "$name"; then
                log_error "Invalid project name '$name': only letters, digits, '.', '_', '-' are allowed"
                exit 1
            fi

            if project_exists "$name"; then
                log_error "Project '$name' already exists. Use 'sm remove $name' first, or pick a different name."
                exit 1
            fi

            read -p "Description: " description
            [[ -z "$description" ]] && description="$name service"
            
            read -p "Command to start the service (e.g., 'path/to/python main.py', './myapp', etc.): " exec_command
            [[ -z "$exec_command" ]] && { log_error "Start command is required"; exit 1; }

            # Parse the command to extract the executable and arguments
            read -a cmd_array <<< "$exec_command"
            executable="${cmd_array[0]}"
            args="${cmd_array[@]:1}"

            # Handle different types of executables
            if [[ "$executable" =~ ^/ ]]; then
                # Already absolute path
                abs_executable="$executable"
            elif command -v "$executable" >/dev/null 2>&1; then
                # It's a system command (like python, node, java, etc.)
                abs_executable="$(command -v "$executable")"
                log_info "Using system executable: $abs_executable"
            else
                # Relative path - make it absolute
                abs_executable="$current_dir/$executable"
            fi

            # Validate the executable
            if command -v "$executable" >/dev/null 2>&1; then
                # System command exists
                log_info "System command '$executable' found"
            elif [[ -f "$abs_executable" && -x "$abs_executable" ]]; then
                # Local executable exists and is executable
                log_info "Local executable '$abs_executable' found"
            elif [[ -f "$abs_executable" ]]; then
                # File exists but not executable
                log_warning "File '$abs_executable' exists but is not executable. You may need to run: chmod +x '$abs_executable'"
            else
                # File doesn't exist
                log_warning "Executable '$executable' not found in PATH or at '$abs_executable'"
            fi

            # For relative paths in the final command, we might want to use absolute paths
            if [[ "$executable" =~ ^/ ]] || command -v "$executable" >/dev/null 2>&1; then
                # Use the command as-is (absolute path or system command)
                final_exec_start="$exec_command"
            else
                # Convert relative executable to absolute path
                final_exec_start="$abs_executable $args"
            fi

            log_info "ExecStart will be set to: $final_exec_start"

            local user=$(whoami)
            local service_file=$(generate_service "$name" "$description" "$final_exec_start" "$current_dir" "$user")

            log_success "Generated service file: $service_file"

            if [[ -f "/etc/systemd/system/$name.service" ]]; then
                log_warning "Service '$name.service' already exists in systemd"
                read -p "Overwrite it with the newly generated file? (y/N): " overwrite
                if [[ ! "$overwrite" =~ ^[Yy]$ ]]; then
                    log_info "Operation cancelled"
                    exit 0
                fi
            fi

            # Install the service
            sudo cp "$service_file" "/etc/systemd/system/"
            sudo systemctl daemon-reload

            add_to_registry "$name" "$service_file" "$current_dir" 1
            log_success "Project '$name' added successfully, to start it, use 'sm start $name'"
        fi
    else
        # Use existing service file
        if [[ ${#service_files[@]} -eq 1 ]]; then
            local service_file="${service_files[0]}"
        else
            echo "Multiple .service files found:"
            for i in "${!service_files[@]}"; do
                echo "  $((i+1))) ${service_files[$i]}"
            done
            read -p "Select service file (1-${#service_files[@]}): " choice
            if [[ "$choice" -ge 1 && "$choice" -le ${#service_files[@]} ]] 2>/dev/null; then
                service_file="${service_files[$((choice-1))]}"
            else
                log_error "Invalid selection"
                exit 1
            fi
        fi

        local name=$(basename "$service_file" .service)

        if ! valid_project_name "$name"; then
            log_error "Invalid project name '$name' (from $service_file): only letters, digits, '.', '_', '-' are allowed"
            exit 1
        fi

        if project_exists "$name"; then
            log_error "Project '$name' already exists"
            exit 1
        fi
        
        # Check if service already exists in systemd
        if [[ -f "/etc/systemd/system/$name.service" ]]; then
            log_warning "Service '$name.service' already exists in systemd"
            echo
            echo "Options:"
            echo "  1) Add to sm management only (recommended if service is already working)"
            echo "  2) Overwrite systemd service file and reload"
            echo "  3) Cancel"
            echo
            read -p "Choose option (1-3): " choice
            
            case "$choice" in
                1)
                    # Just add to registry without touching systemd. sm
                    # didn't install this unit file, so it doesn't own it:
                    # 'sm remove' must not delete it later.
                    add_to_registry "$name" "$current_dir/$service_file" "$current_dir" 0
                    log_success "Project '$name' added to sm management"
                    ;;
                2)
                    # Overwrite and reload
                    log_info "Overwriting existing service file..."
                    sudo cp "$service_file" "/etc/systemd/system/"
                    sudo systemctl daemon-reload
                    add_to_registry "$name" "$current_dir/$service_file" "$current_dir" 1
                    log_success "Project '$name' added and service file updated"
                    ;;
                3)
                    log_info "Operation cancelled"
                    exit 0
                    ;;
                *)
                    log_error "Invalid option"
                    exit 1
                    ;;
            esac
        else
            # Service doesn't exist, install normally
            sudo cp "$service_file" "/etc/systemd/system/"
            sudo systemctl daemon-reload
            add_to_registry "$name" "$current_dir/$service_file" "$current_dir" 1
            log_success "Project '$name' added successfully, to start it, use 'sm start $name'"
        fi
    fi
}

cmd_start() {
    local name=""
    local do_enable=true
    local skip_verify=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-enable)
                do_enable=false
                shift
                ;;
            --skip-verify)
                skip_verify=true
                shift
                ;;
            -*)
                log_error "Unknown flag: $1"
                log_info "Usage: sm start [project_name] [--no-enable] [--skip-verify]"
                exit 1
                ;;
            *)
                name="$1"
                shift
                ;;
        esac
    done

    # If no name provided, try to infer from current directory
    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm start <project_name> or run from directory containing .service file"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi

    if ! project_exists "$name"; then
        log_error "Project '$name' not found. Use 'sm ls' to see available projects or 'sm add' to add it."
        exit 1
    fi

    if [[ "$skip_verify" != true ]]; then
        if ! verify_service_file "$name"; then
            log_info "Fix the issue above, or re-run with --skip-verify to start anyway."
            exit 1
        fi
    fi

    log_info "Starting service '$name'..."
    if [[ "$do_enable" == true ]]; then
        sudo systemctl enable "$name.service"
    fi
    sudo systemctl restart "$name.service"

    # Check if service started successfully
    if systemctl is-active --quiet "$name.service"; then
        log_success "Service '$name' started successfully"
    else
        log_error "Failed to start service '$name'"
        echo "Use 'sm logs $name' to see error details"
        exit 1
    fi
}

cmd_restart() {
    local name=""
    local skip_verify=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --skip-verify)
                skip_verify=true
                shift
                ;;
            -*)
                log_error "Unknown flag: $1"
                log_info "Usage: sm restart [project_name] [--skip-verify]"
                exit 1
                ;;
            *)
                name="$1"
                shift
                ;;
        esac
    done

    # If no name provided, try to infer from current directory
    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm restart <project_name> or run from directory containing .service file"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi

    if ! project_exists "$name"; then
        log_error "Project '$name' not found. Use 'sm ls' to see available projects."
        exit 1
    fi

    if [[ "$skip_verify" != true ]]; then
        if ! verify_service_file "$name"; then
            log_info "Fix the issue above, or re-run with --skip-verify to restart anyway."
            exit 1
        fi
    fi

    # Deliberately does not touch the enabled/disabled state, unlike
    # 'sm start' -- this only restarts, it doesn't change boot behavior.
    log_info "Restarting service '$name'..."
    sudo systemctl restart "$name.service"

    if systemctl is-active --quiet "$name.service"; then
        log_success "Service '$name' restarted successfully"
    else
        log_error "Failed to restart service '$name'"
        echo "Use 'sm logs $name' to see error details"
        exit 1
    fi
}

cmd_stop() {
    local name=""
    local do_disable=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --disable)
                do_disable=true
                shift
                ;;
            -*)
                log_error "Unknown flag: $1"
                log_info "Usage: sm stop [project_name] [--disable]"
                exit 1
                ;;
            *)
                name="$1"
                shift
                ;;
        esac
    done

    # If no name provided, try to infer from current directory
    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm stop <project_name> or run from directory containing .service file"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi

    if ! project_exists "$name"; then
        log_error "Project '$name' not found. Use 'sm ls' to see available projects."
        exit 1
    fi

    log_info "Stopping service '$name'..."
    sudo systemctl stop "$name.service"
    if [[ "$do_disable" == true ]]; then
        sudo systemctl disable "$name.service"
        log_success "Service '$name' stopped and disabled (won't start on boot)"
    else
        log_success "Service '$name' stopped"
        log_info "Note: it is still enabled and will start again on boot. Use 'sm stop --disable' to prevent that."
    fi
}

cmd_info() {
    local name="$1"
    
    # If no name provided, try to infer from current directory
    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm info <project_name> or run from directory containing .service file"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi
    
    if ! project_exists "$name"; then
        log_error "Project '$name' not found. Use 'sm ls' to see available projects."
        exit 1
    fi
    
    # Get project data from registry (4th field is the "owned" flag; read
    # into a var even though it's unused here so it doesn't get appended
    # onto work_dir)
    local service_file working_dir
    while IFS=':' read -r proj_name svc_file work_dir _owned; do
        if [[ "$proj_name" == "$name" ]]; then
            service_file="$svc_file"
            working_dir="$work_dir"
            break
        fi
    done < "$SM_PROJECTS_FILE"
    
    echo
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  Project Information: ${GREEN}$name${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo
    
    # Service file location
    echo -e "${YELLOW}Service File:${NC}"
    echo "  Local:  $service_file"
    echo "  System: /etc/systemd/system/$name.service"
    echo
    
    # Working directory
    echo -e "${YELLOW}Working Directory:${NC}"
    echo "  $working_dir"
    echo
    
    # Git status
    echo -e "${YELLOW}Git Status:${NC}"
    if [[ -d "$working_dir/.git" ]]; then
        pushd "$working_dir" > /dev/null 2>&1
        local branch=$(git branch --show-current 2>/dev/null)
        local commit=$(git rev-parse --short HEAD 2>/dev/null)
        local status=$(git status --porcelain 2>/dev/null)
        popd > /dev/null 2>&1
        
        if [[ -n "$branch" ]]; then
            echo "  Branch: $branch"
        fi
        if [[ -n "$commit" ]]; then
            echo "  Commit: $commit"
        fi
        if [[ -z "$status" ]]; then
            echo -e "  Status: ${GREEN}Clean${NC}"
        else
            echo -e "  Status: ${YELLOW}Modified${NC}"
        fi
    else
        echo "  Not a git repository"
    fi
    echo
    
    # Active state and systemctl info
    echo -e "${YELLOW}Service Status:${NC}"
    local active_state=$(systemctl show -p ActiveState "$name.service" 2>/dev/null | cut -d= -f2)
    local sub_state=$(systemctl show -p SubState "$name.service" 2>/dev/null | cut -d= -f2)
    local load_state=$(systemctl show -p LoadState "$name.service" 2>/dev/null | cut -d= -f2)
    
    if [[ "$active_state" == "active" ]]; then
        echo -e "  State: ${GREEN}$active_state ($sub_state)${NC}"
    elif [[ "$active_state" == "inactive" ]]; then
        echo -e "  State: ${RED}$active_state ($sub_state)${NC}"
    elif [[ "$active_state" == "failed" ]]; then
        echo -e "  State: ${RED}$active_state ($sub_state)${NC}"
    else
        echo "  State: $active_state ($sub_state)"
    fi
    echo "  Load: $load_state"
    
    # Auto-restart info
    local restart=$(systemctl show -p Restart "$name.service" 2>/dev/null | cut -d= -f2)
    echo "  Restart Policy: $restart"
    echo
    
    # Memory/CPU and uptime (only if active)
    if [[ "$active_state" == "active" ]]; then
        echo -e "${YELLOW}Resource Usage:${NC}"
        local main_pid=$(systemctl show -p MainPID "$name.service" 2>/dev/null | cut -d= -f2)
        
        if [[ -n "$main_pid" && "$main_pid" != "0" ]]; then
            echo "  PID: $main_pid"
            
            # Get memory and CPU from ps
            local mem_cpu=$(ps -p "$main_pid" -o rss,pcpu --no-headers 2>/dev/null)
            if [[ -n "$mem_cpu" ]]; then
                local rss=$(echo "$mem_cpu" | awk '{print $1}')
                local cpu=$(echo "$mem_cpu" | awk '{print $2}')
                local mem_mb=$(awk "BEGIN {printf \"%.1f\", $rss/1024}")
                echo "  Memory: ${mem_mb}M"
                echo "  CPU: ${cpu}%"
            fi
        else
            echo "  No main process found"
        fi
        echo
        
        # Time since last start
        echo -e "${YELLOW}Uptime:${NC}"
        local active_enter=$(systemctl show -p ActiveEnterTimestamp "$name.service" 2>/dev/null | cut -d= -f2)
        if [[ -n "$active_enter" && "$active_enter" != "n/a" ]]; then
            local uptime=$(format_uptime "$active_enter")
            echo "  Running for: $uptime"
            echo "  Started at: $active_enter"
        else
            echo "  N/A"
        fi
    else
        # Show when it was last stopped
        local inactive_enter=$(systemctl show -p InactiveEnterTimestamp "$name.service" 2>/dev/null | cut -d= -f2)
        if [[ -n "$inactive_enter" && "$inactive_enter" != "n/a" ]]; then
            echo
            echo -e "${YELLOW}Last Activity:${NC}"
            echo "  Stopped at: $inactive_enter"
        fi
    fi
    
    echo
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo
}

# Normalize shorthand time/date formats into journalctl-compatible strings
parse_since() {
    local input="$1"

    # Relative time: 1h, 2h, 30m, 30min, 2d, 1w
    if [[ "$input" =~ ^([0-9]+)(w|d|h|m|min)$ ]]; then
        local amount="${BASH_REMATCH[1]}"
        local unit="${BASH_REMATCH[2]}"
        case "$unit" in
            w)   echo "${amount} weeks ago" ;;
            d)   echo "${amount} days ago" ;;
            h)   echo "${amount} hours ago" ;;
            m|min) echo "${amount} minutes ago" ;;
        esac
        return 0
    fi

    # Date: DD.MM.YY or DD.MM.YYYY
    if [[ "$input" =~ ^([0-9]{2})\.([0-9]{2})\.([0-9]{2,4})$ ]]; then
        local day="${BASH_REMATCH[1]}"
        local month="${BASH_REMATCH[2]}"
        local year="${BASH_REMATCH[3]}"
        # Expand 2-digit year to 4-digit
        if [[ ${#year} -eq 2 ]]; then
            year="20${year}"
        fi
        echo "${year}-${month}-${day}"
        return 0
    fi

    # Date + time: DD.MM.YY HH:MM or DD.MM.YYYY HH:MM
    if [[ "$input" =~ ^([0-9]{2})\.([0-9]{2})\.([0-9]{2,4})\ ([0-9]{2}:[0-9]{2})$ ]]; then
        local day="${BASH_REMATCH[1]}"
        local month="${BASH_REMATCH[2]}"
        local year="${BASH_REMATCH[3]}"
        local time="${BASH_REMATCH[4]}"
        if [[ ${#year} -eq 2 ]]; then
            year="20${year}"
        fi
        echo "${year}-${month}-${day} ${time}"
        return 0
    fi

    # Pass through anything else (e.g. already-valid "2026-02-26" or "yesterday")
    echo "$input"
}

cmd_logs() {
    local name=""
    local lines=100
    local lines_explicit=false
    local follow=true          # default ON now
    local since=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--lines)
                if [[ -z "$2" || ! "$2" =~ ^[0-9]+$ ]]; then
                    log_error "--lines requires a positive integer"
                    exit 1
                fi
                lines="$2"
                lines_explicit=true
                shift 2
                ;;
            -f|--follow)
                follow=true
                shift
                ;;
            --no-follow)
                follow=false
                shift
                ;;
            -s|--since)
                if [[ -z "$2" ]]; then
                    log_error "--since requires a value (e.g. '1h', '2d', '26.02.26')"
                    exit 1
                fi
                since=$(parse_since "$2")
                shift 2
                ;;
            -h|--help)
                log_info "Usage: sm logs [project_name] [-n lines] [-f|--no-follow] [-s since (e.g. '1h', '2d', '26.02.26')]"
                exit 1
                ;;
            -*)
                log_error "Unknown flag: $1"
                log_info "Usage: sm logs [project_name] [-n lines] [-f|--no-follow] [-s since]"
                exit 1
                ;;
            *)
                name="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm logs <project_name> [-n lines] [-f|--no-follow] [-s since]"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi

    if ! project_exists "$name"; then
        log_error "Project '$name' not found. Use 'sm ls' to see available projects."
        exit 1
    fi

    local jctl_args=(-u "$name.service" --no-pager)

    if [[ -n "$since" ]]; then
        jctl_args+=(--since "$since")
        # Only cap lines here if the user explicitly asked for it with -n;
        # otherwise -s alone means "show everything since that time", as
        # before. Without this, -s silently swallowed a co-supplied -n.
        [[ "$lines_explicit" == true ]] && jctl_args+=(-n "$lines")
    else
        jctl_args+=(-n "$lines")
    fi

    if [[ "$follow" == true ]]; then
        jctl_args+=(-f)
        log_info "Following logs for '$name' (Ctrl+C to stop)..."
    else
        log_info "Showing last $lines lines for '$name'..."
    fi
    [[ -n "$since" ]] && log_info "  Since: $since"
    echo

    # No trap here: exec below replaces this process image, so any trap
    # set on it would never fire. journalctl handles Ctrl+C on its own.
    exec journalctl "${jctl_args[@]}"
}

cmd_workdir() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        exit 1
    fi
    
    if ! project_exists "$name"; then
        exit 1
    fi
    
    while IFS=':' read -r proj_name service_file working_dir _owned; do
        if [[ "$proj_name" == "$name" ]]; then
            echo "$working_dir"
            exit 0
        fi
    done < "$SM_PROJECTS_FILE"
    
    exit 1
}


# Helper function to format uptime
format_uptime() {
    local uptime_str="$1"
    if [[ -z "$uptime_str" || "$uptime_str" == "n/a" ]]; then
        echo "-"
        return
    fi
    
    # Split declaration from assignment: `local x=$(...)` always makes `$?`
    # reflect `local`'s own exit status (0), never the substitution's.
    local start_epoch
    start_epoch=$(date -d "$uptime_str" +%s 2>/dev/null)
    if [[ $? -ne 0 || -z "$start_epoch" ]]; then
        echo "-"
        return
    fi
    
    local current_epoch=$(date +%s)
    local diff=$((current_epoch - start_epoch))
    
    if [[ $diff -lt 60 ]]; then
        echo "${diff}s"
    elif [[ $diff -lt 3600 ]]; then
        echo "$((diff/60))m"
    elif [[ $diff -lt 86400 ]]; then
        echo "$((diff/3600))h$((diff%3600/60))m"
    else
        echo "$((diff/86400))d$((diff%86400/3600))h"
    fi
}

cmd_ls() {
    if [[ ! -s "$SM_PROJECTS_FILE" ]]; then
        log_info "No projects found. Use 'sm add' to add a project."
        return
    fi
    
    echo
    printf "%-20s %-10s %-8s %-10s %-12s %-30s\n" "NAME" "STATUS" "PID" "MEMORY" "UPTIME" "WORKING DIRECTORY"
    printf "%-20s %-10s %-8s %-10s %-12s %-30s\n" "----" "------" "---" "------" "------" "-----------------"
    
    # Read all project names first
    local -a project_names=()
    local -A project_data=()
    
    while IFS=':' read -r name service_file working_dir _owned; do
        project_names+=("$name")
        project_data["$name"]="$service_file:$working_dir"
    done < "$SM_PROJECTS_FILE"
    
    # Batch systemctl calls for better performance
    local -A service_status=()
    local -A service_pids=()
    local -A service_uptimes=()
    
    # Get all statuses in one call
    if [[ ${#project_names[@]} -gt 0 ]]; then
        local services=()
        for name in "${project_names[@]}"; do
            services+=("$name.service")
        done
        
        # Batch status check
        while read -r service status; do
            local name="${service%.service}"
            service_status["$name"]="$status"
        done < <(systemctl is-active "${services[@]}" 2>/dev/null | nl -nln -w1 -s' ' | while read -r i status; do
            echo "${services[$((i-1))]} $status"
        done)
        
        # Get running services for PID and uptime batch queries
        local -a running_services=()
        for name in "${project_names[@]}"; do
            if [[ "${service_status[$name]}" == "active" ]]; then
                running_services+=("$name.service")
            fi
        done
        
        # Batch PID retrieval for running services
        if [[ ${#running_services[@]} -gt 0 ]]; then
            while read -r service pid; do
                local name="${service%.service}"
                [[ "$pid" == "0" ]] && pid="-"
                service_pids["$name"]="$pid"
            done < <(systemctl show -p MainPID "${running_services[@]}" 2>/dev/null | \
                    grep -E '^MainPID=' | \
                    paste <(printf '%s\n' "${running_services[@]}") - | \
                    sed 's/MainPID=//')
            
            # Batch uptime retrieval for running services
            while read -r service timestamp; do
                local name="${service%.service}"
                service_uptimes["$name"]="$timestamp"
            done < <(systemctl show -p ActiveEnterTimestamp "${running_services[@]}" 2>/dev/null | \
                    grep -E '^ActiveEnterTimestamp=' | \
                    paste <(printf '%s\n' "${running_services[@]}") - | \
                    sed 's/ActiveEnterTimestamp=//')
        fi
    fi
    
    # Get memory info for all PIDs in one ps call
    local -A pid_memory=()
    local -a all_pids=()
    for name in "${project_names[@]}"; do
        local pid="${service_pids[$name]}"
        if [[ -n "$pid" && "$pid" != "-" ]]; then
            all_pids+=("$pid")
        fi
    done
    
    if [[ ${#all_pids[@]} -gt 0 ]]; then
        while read -r pid rss; do
            pid_memory["$pid"]=$(awk "BEGIN {printf \"%.1fM\", $rss/1024}")
        done < <(ps -o pid,rss --no-headers -p $(IFS=','; echo "${all_pids[*]}") 2>/dev/null)
    fi
    
    # Now display all projects
    for name in "${project_names[@]}"; do
        IFS=':' read -r service_file working_dir <<< "${project_data[$name]}"
        
        local status="${service_status[$name]:-inactive}"
        local pid="${service_pids[$name]:--}"
        local memory="-"
        local uptime="-"
        
        if [[ "$status" == "active" ]]; then
            status="running"
            
            # Get memory from our cached data
            if [[ "$pid" != "-" ]]; then
                memory="${pid_memory[$pid]:--}"
            fi
            
            # Format uptime
            uptime=$(format_uptime "${service_uptimes[$name]}")
        else
            status="stopped"
        fi
        
        # Display with colors
        if [[ "$status" == "running" ]]; then
            echo -e "$(printf "%-20s " "$name")${GREEN}$(printf "%-10s" "$status")${NC}$(printf " %-8s %-10s %-12s %-30s" "$pid" "$memory" "$uptime" "$working_dir")"
        else
            echo -e "$(printf "%-20s " "$name")${RED}$(printf "%-10s" "$status")${NC}$(printf " %-8s %-10s %-12s %-30s" "$pid" "$memory" "$uptime" "$working_dir")"
        fi
    done
    echo
}

cmd_remove() {
    local name="$1"
    
    # If no name provided, try to infer from current directory
    if [[ -z "$name" ]]; then
        name=$(infer_project_name) || true
        if [[ $? -ne 0 || -z "$name" ]]; then
            log_error "No project name provided and no .service file found in current directory"
            log_info "Usage: sm remove <project_name> or run from directory containing .service file"
            exit 1
        fi
        log_info "Inferred project name: $name"
    fi
    
    if ! project_exists "$name"; then
        log_error "Project '$name' not found"
        exit 1
    fi

    # Look up whether sm actually installed this unit file (owned=1) or
    # only registered a pre-existing one it doesn't manage (owned=0), so we
    # know whether it's ours to delete. Legacy entries predate this field
    # and default to owned=1, matching the old (always-delete) behavior.
    local owned=""
    while IFS=':' read -r proj_name _svc_file _work_dir own_flag; do
        if [[ "$proj_name" == "$name" ]]; then
            owned="$own_flag"
            break
        fi
    done < "$SM_PROJECTS_FILE"
    [[ -z "$owned" ]] && owned=1

    read -p "Confirm to remove the project? (y/N): " confirm

    if [[ "$confirm" =~ ^[Yy]$ ]]; then

        log_info "Removing project '$name'..."

        # Stop and disable service
        sudo systemctl stop "$name.service" 2>/dev/null || true
        sudo systemctl disable "$name.service" 2>/dev/null || true

        if [[ "$owned" == "1" ]]; then
            # sm installed this unit file, so it's sm's to remove
            sudo rm -f "/etc/systemd/system/$name.service"
            sudo systemctl daemon-reload
        else
            log_info "Unit file was not installed by sm (added via 'management only'); leaving /etc/systemd/system/$name.service in place"
        fi

        # Remove from registry
        remove_from_registry "$name"

        log_success "Project '$name' removed successfully"
    fi
}


cmd_update() {
    local repo_dir
    repo_dir=$(find_sm_repo)
    
    if [[ -z "$repo_dir" ]]; then
        log_error "Could not find sm repository directory"
        exit 1
    fi
    
    if [[ ! -d "$repo_dir/.git" ]]; then
        log_error "sm repository directory is not a git repository: $repo_dir"
        log_info "The sm script should be in a git repository to use the update command"
        exit 1
    fi
    
    log_info "Updating sm from repository in: $repo_dir"
    
    # Change to repo directory and pull updates
    if (cd "$repo_dir" && git pull origin master); then
        log_success "sm updated successfully"
        log_info "Changes are immediately available since sm is symlinked"
    else
        log_error "Failed to update sm repository"
        exit 1
    fi
}

cmd_dive_dummy() {
    log_info "This command is not supposed to be run directly, looks like you haven't run 'sm install-helpers' yet."
    local name="$1"
    if [[ -z "$name" ]]; then
        log_info "To get the working directory, run 'sm workdir $name'"
    fi
}

cmd_install_helpers() {
    local repo_dir
    repo_dir=$(find_sm_repo)
    
    if [[ ! -f "$repo_dir/sm-completion.sh" ]]; then
        log_error "Completion script not found at: $repo_dir/sm-completion.sh"
        exit 1
    fi
    
    local bashrc="$HOME/.bashrc"
    local source_line="[[ -f \"$repo_dir/sm-completion.sh\" ]] && source \"$repo_dir/sm-completion.sh\""
    
    # Check if already installed
    if grep -qF "$repo_dir/sm-completion.sh" "$bashrc" 2>/dev/null; then
        log_info "Completion already installed in ~/.bashrc"
        log_info "Run 'source ~/.bashrc' to reload if needed"
    else
        echo "" >> "$bashrc"
        echo "# SM (Service Manager) helpful features" >> "$bashrc"
        echo "$source_line" >> "$bashrc"
        log_success "Completion installed to ~/.bashrc"
        log_info "Run 'source ~/.bashrc' or restart your terminal to activate"
    fi

    if [[ ! -f "$repo_dir/sm-wrapper-for-dive.sh" ]]; then
        log_error "Sm wrapper-for-dive not found at: $repo_dir/sm-wrapper-for-dive.sh"
        exit 1
    fi

    local source_line="[[ -f \"$repo_dir/sm-wrapper-for-dive.sh\" ]] && source \"$repo_dir/sm-wrapper-for-dive.sh\""

    # Check if already installed
    if grep -qF "$repo_dir/sm-wrapper-for-dive.sh" "$bashrc" 2>/dev/null; then
        log_info "Diving feature already installed in ~/.bashrc"
        log_info "Run 'source ~/.bashrc' to reload if needed"
    else
        echo "" >> "$bashrc"
        echo "$source_line" >> "$bashrc"
        log_success "Diving feature installed to ~/.bashrc"
        log_info "Run 'source ~/.bashrc' or restart your terminal to activate"
    fi
}

cmd_uninstall() {
    log_info "This will remove SM (Service Manager) from your system"
    echo ""
    echo "The following will be removed:"
    echo "  - SM directory and all data: $SM_DIR"
    echo "  - Symlink from /usr/local/bin/sm"
    echo "  - Entries from ~/.bashrc (completion and diving features)"
    echo ""
    
    read -p "Do you want to proceed with uninstallation? [y/N]: " -r confirm
    echo ""
    
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log_info "Uninstallation cancelled"
        return 0
    fi
    
    local errors=0
    
    # Remove bashrc entries
    log_info "Removing entries from ~/.bashrc..."
    local bashrc="$HOME/.bashrc"
    local repo_dir
    repo_dir=$(find_sm_repo 2>/dev/null || echo "")
    
    if [[ -f "$bashrc" ]]; then
        # Create backup
        local backup_file="$bashrc.sm-backup-$(date +%Y%m%d-%H%M%S)"
        # create a backup file
        cp "$bashrc" "$backup_file"
        log_info "Created backup of ~/.bashrc: $backup_file"
        
        # Remove SM-related lines
        if [[ -n "$repo_dir" ]]; then
            # Remove specific source lines and the header comment
            sed -i "/# SM (Service Manager) helpful features/d" "$bashrc"
            sed -i "\|$repo_dir/sm-completion.sh|d" "$bashrc"
            sed -i "\|$repo_dir/sm-wrapper-for-dive.sh|d" "$bashrc"
            log_success "Removed SM entries from ~/.bashrc"
        else
            log_warning "Could not find repo directory, manual cleanup of ~/.bashrc may be needed"
        fi
    else
        log_warning "~/.bashrc not found, skipping"
    fi
    
    # Remove SM directory
    if [[ -d "$SM_DIR" ]]; then
        log_info "Removing SM directory: $SM_DIR"
        if rm -rf "$SM_DIR"; then
            log_success "Removed $SM_DIR"
        else
            log_error "Failed to remove $SM_DIR"
            ((errors++))
        fi
    else
        log_info "SM directory not found: $SM_DIR"
    fi
    
    # Remove symlink from /usr/local/bin
    if [[ -L "/usr/local/bin/sm" ]]; then
        log_info "Removing symlink from /usr/local/bin/sm"
        if sudo rm "/usr/local/bin/sm"; then
            log_success "Removed /usr/local/bin/sm"
        else
            log_error "Failed to remove /usr/local/bin/sm"
            ((errors++))
        fi
    else
        log_info "Symlink not found: /usr/local/bin/sm"
    fi
    
    # Offer to delete cloned repository
    if [[ -n "$repo_dir" && -d "$repo_dir" ]]; then
        echo ""
        log_info "Found SM repository at: $repo_dir"
        read -p "Do you want to delete the cloned repository as well? [y/N]: " -r delete_repo
        echo ""
        
        if [[ "$delete_repo" =~ ^[Yy]$ ]]; then
            log_info "Removing repository directory: $repo_dir"
            if rm -rf "$repo_dir"; then
                log_success "Removed repository: $repo_dir"
            else
                log_error "Failed to remove repository: $repo_dir"
                ((errors++))
            fi
        else
            log_info "Repository kept at: $repo_dir"
        fi
    fi
    
    echo ""
    if [[ $errors -eq 0 ]]; then
        log_success "SM has been successfully uninstalled"
        log_info "You may want to run 'source ~/.bashrc' or restart your terminal"
    else
        log_warning "Uninstallation completed with $errors error(s)"
        log_info "You may need to manually clean up some files"
        return 1
    fi
}

cmd_help() {
    echo "Service Manager (sm) - A lightweight wrapper around systemctl"
    echo
    echo "Usage:"
    echo "  sm add                        - Add project from current directory"
    echo "  sm start [project_name] [--no-enable] [--skip-verify]"
    echo "                                 - Start a project and enable it at boot (infers name if not provided;"
    echo "                                   --no-enable starts without changing the enabled state)"
    echo "  sm restart [project_name] [--skip-verify]"
    echo "                                 - Restart a project without touching its enabled/disabled state"
    echo "  (sm start/restart run 'systemd-analyze verify' on the unit file first; --skip-verify bypasses it)"
    echo "  sm stop [project_name] [--disable]"
    echo "                                 - Stop a project (infers name if not provided); it stays enabled"
    echo "                                   at boot unless --disable is given"
    echo "  sm info [project_name]        - Show project info (infers name from .service file if not provided)"
    echo "  sm logs [project_name]        - Show project logs (infers name from .service file if not provided)"
    echo "  sm remove/rm [project_name]   - Remove a project (infers name from .service file if not provided)"
    echo "  sm workdir [project_name]     - Echo the project folder path"
    echo "  sm dive/cd [project_name]     - Dive into a project folder (make sure to run 'sm install-helpers' first once)"
    echo "  sm ls/list                    - List all projects"
    echo "  sm update                     - Update sm from git repository"
    echo "  sm install-helpers            - Install tab completion and 'sm dive' working properly into your ~/.bashrc"
    echo "  sm help                       - Show this help message"
    echo "  sm uninstall                  - Uninstall sm and clean up files"
    echo
    echo "Note: Commands that accept [project_name] will automatically infer the project name"
    echo "      from .service files in the current directory if no name is provided."
    echo
}

# Main command dispatcher
main() {
    init_sm
    
    local command="$1"
    shift || true
    
    case "$command" in
        add)
            cmd_add "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        info)
            cmd_info "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        ls|list)
            cmd_ls "$@"
            ;;
        remove|rm)
            cmd_remove "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        workdir)
            cmd_workdir "$@"
            ;;
        install-helpers)
            cmd_install_helpers "$@"
            ;;
        dive|cd)
            cmd_dive_dummy "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        uninstall|--uninstall)
            cmd_uninstall
            ;;
        "")
            log_error "No command specified. Use 'sm help' for usage information."
            exit 1
            ;;
        *)
            log_error "Unknown command: $command"
            cmd_help
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"
